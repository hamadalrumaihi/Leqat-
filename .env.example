# ── Supabase ───────────────────────────────────────────────
# Project URL and anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI (report assistant, translation, auto-captions) ─────
# Server-only. If unset, the report assistant falls back to a
# deterministic Arabic template (no external call).
AI_API_KEY=
AI_MODEL=

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ── Firebase Cloud Messaging (push notifications) ──────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Payments ───────────────────────────────────────────────
# Qatar-friendly gateway (Dibsy or MyFatoorah). Stripe is the
# international fallback.
# sandbox = settle immediately (demo). Set to dibsy|myfatoorah|stripe
# and add the matching keys to use a real gateway.
PAYMENT_PROVIDER=sandbox
DIBSY_SECRET_KEY=
DIBSY_WEBHOOK_SECRET=
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (weekly digest) ──────────────────────────────────
# If unset, the digest cron runs in stub mode (logs, no send).
RESEND_API_KEY=
EMAIL_FROM=Le.Qat <no-reply@leqat.qa>
AWS_SES_REGION=
# Protects /api/cron/weekly-digest (Vercel Cron sends this bearer).
CRON_SECRET=

# ── Substitute magic links ─────────────────────────────────
# Required to enable time-boxed unauthenticated substitute access.
SUBSTITUTE_LINK_SECRET=

# ── Media storage (optional Cloudflare R2 instead of Supabase)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
